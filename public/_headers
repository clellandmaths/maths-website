# Cloudflare Pages response headers.
#
# The site is a static export with no server, no accounts and no user input, so
# the classic injection risks are largely absent. These are defence in depth:
# they cost nothing and they close the cheap attacks — clickjacking, MIME
# sniffing, referrer leakage.

/*
  # Stop a browser second-guessing a Content-Type and running a .txt as script.
  X-Content-Type-Options: nosniff

  # Nobody has any business framing this site. Belt and braces with the CSP
  # frame-ancestors below, which is the modern equivalent.
  X-Frame-Options: DENY

  # Send the origin to other sites, never the full path. A worksheet URL
  # carries the questions someone picked; that should not leak to YouTube.
  Referrer-Policy: strict-origin-when-cross-origin

  # Nothing here needs a camera, a microphone or a location.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

  # HTTPS only, for a year, once seen. Cloudflare already redirects, but this
  # removes the first insecure request on repeat visits.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # 'unsafe-inline' is unavoidable: Next inlines its bootstrap and the RSC
  # payload as inline <script>, and a static export cannot mint per-request
  # nonces. It still blocks loading script from anywhere unlisted, which is
  # the part that matters here.
  # img.youtube.com / i.ytimg.com serve the video thumbnails; frame-src is the
  # privacy-enhanced player; connect-src covers Cloudflare Web Analytics.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.youtube.com https://i.ytimg.com; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# The RStudio workbook is a Quarto build that runs R in the browser. It pulls
# the R runtime and packages from webR's CDN and its datasets from GitHub, and
# WebAssembly needs wasm-unsafe-eval. The strict policy above would break it
# entirely, so this path gets its own.
/course/higher-apps/rstudio/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Rules here ADD to the /* block, they do not replace it. Two CSP headers
  # means the browser enforces both, and the strict one above would have
  # blocked webR — killing the workbook while looking like it was configured
  # correctly. Drop the inherited one first, then set this path's own.
  ! Content-Security-Policy
  # Quarto's Bootstrap theme @imports Lato from Google Fonts, and webR pulls
  # its runtime and packages from the r-wasm hosts. The datasets come from
  # raw.githubusercontent.com, which 302s to objects.githubusercontent.com
  # for the actual bytes — CSP checks the redirect target as well as the
  # first URL, so the whole family has to be allowed or the fetch dies
  # halfway with nothing useful in the console.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.r-wasm.org; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: blob: https://*.githubusercontent.com; font-src 'self' data: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' blob: https://*.r-wasm.org https://*.githubusercontent.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'

# Hashed build assets never change under the same name, so they can be cached
# hard. Everything else stays on Cloudflare's default so a deploy is visible.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images were on Cloudflare's default, measured live as
# `max-age=14400, must-revalidate` — four hours, and then a round trip per file
# to be told nothing had changed. There are 443 of them weighing 5.9 MB, most of
# it past paper diagrams that cannot change because the exams already happened.
# A pupil working a paper with five diagrams paid five of those round trips on
# every visit past the fourth hour.
#
# Thirty days, deliberately not a year: these filenames are not content-hashed
# the way `/_next/static` is, so the price of caching hard is that replacing a
# diagram under its own name leaves people on the old one until it expires. A
# month is long enough to be worth having and short enough to wait out. If a
# correction ever has to be immediate, rename the file or purge the cache.
/img/*
  Cache-Control: public, max-age=2592000
