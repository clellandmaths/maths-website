# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worksheet generator (separate repo — clellandmaths/clelland-maths-generator)
/worksheet_generator/

# third-party reference material — NEVER commit.
# Heriot-Watt SCHOLAR study guides, "G Whyte 2016" notebooks and textbook units.
# Used to audit our notes for coverage; the notes themselves are written fresh.
/reference/
/resources/

# unrelated scratch: a separate AI Studio scaffold, and a stray Windows
# redirect artefact. Neither belongs in this repo.
/Course Notes/
/nul

# Working reports from the maths.scot sync scripts — regenerate, do not commit
mathsscot-reconciled.json
scan-mathsscot-new.json
mathsscot-additions.json
